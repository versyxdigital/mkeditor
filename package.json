{
  "name": "mkeditor",
  "productName": "MKEditor",
  "version": "5.0.0",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "license": "MIT",
  "author": "Chris Rowles <christopher.rowles@outlook.com>",
  "description": "Markdown Editor",
  "main": "dist/app/main.js",
  "scripts": {
    "prepare": "husky",
    "prettier-check": "prettier . --check",
    "prettier-fix": "prettier . --write",
    "lint": "eslint src",
    "test": "jest",
    "prebuild": "node -p \"\\\"export const APP_VERSION = '\\\" + require('./package.json').version + \\\"';\\\"\" > src/browser/version.ts",
    "build-editor": "npm run prebuild && node ./scripts/combine-locales.mjs && webpack --config webpack.config.js",
    "build-app": "node ./scripts/compile-app.mjs",
    "build-all": "npm run build-editor && npm run build-app",
    "make-installer": "node ./scripts/make-installer.mjs",
    "serve-web": "http-server dist",
    "serve-app": "electron .",
    "verify-drive-writes": "electron scripts/verify-drive-precondition.cjs --authorize-disposable-test",
    "test:drive-smoke": "node scripts/drive-smoke/run.cjs",
    "test:drive-live": "node scripts/drive-smoke/run.cjs --live --authorize-disposable-test",
    "publish": "npm run build-editor && npm run build-app && electron-builder --publish always"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/versyxdigital/mkeditor"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/jest": "^30.0.0",
    "@types/markdown-it-container": "^4.0.1",
    "@types/markdown-it-emoji": "^3.0.1",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "autoprefixer": "^10.7.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.1",
    "eslint": "^10.15.0",
    "file-loader": "^6.2.0",
    "globals": "^17.14.0",
    "html-minimizer-webpack-plugin": "^6.0.0",
    "html-webpack-plugin": "^5.6.8",
    "husky": "9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "monaco-editor-webpack-plugin": "^7.1.1",
    "playwright": "^1.65.1",
    "postcss": "^8.5.33",
    "postcss-loader": "^8.2.2",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "sass-loader": "^17.1.1",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.3.5",
    "terser-webpack-plugin": "^5.6.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "webpack": "^5.113.0",
    "webpack-cli": "^7.3.1"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.107",
    "@ai-sdk/openai": "^4.0.122",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@vscode/markdown-it-katex": "^1.1.2",
    "ai": "^7.0.179",
    "circle-buffer": "^0.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.5.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11",
    "highlight.js": "^11.12.0",
    "i18next": "^27.2.4",
    "jose": "^6.2.3",
    "markdown-it": "^15.0.3",
    "markdown-it-container": "^4.0.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^12.3.0",
    "monaco-editor": "^0.57.0",
    "ollama-ai-provider-v2": "^4.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.24.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "build": {
    "appId": "com.mkeditor.app",
    "files": [
      "**/*",
      "!src/app/config/*.local.json",
      "!out/**/*"
    ],
    "artifactName": "mkeditor-setup-${version}.${ext}",
    "directories": {
      "output": "releases/${platform}/${arch}"
    },
    "fileAssociations": [
      {
        "ext": [
          "md"
        ],
        "name": "Plain Text",
        "role": "Editor"
      }
    ],
    "linux": {
      "target": "deb",
      "icon": "build/resources/icon256x256.png",
      "category": "Utility"
    },
    "mac": {
      "target": "pkg",
      "icon": "build/resources/icon512x512.png"
    },
    "win": {
      "target": "nsis",
      "icon": "build/resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "installerIcon": "build/resources/icon.ico",
      "license": "build/resources/license.txt"
    },
    "pkg": {
      "license": "build/resources/license.txt"
    },
    "publish": {
      "provider": "github",
      "owner": "versyxdigital",
      "repo": "mkeditor"
    }
  }
}
